# ========================================================
# Variables de entorno para Vercel - MathVerse II
# ========================================================

# Clave de API de Google Gemini (requerida para el Profesor Virtual)
# Obtenla en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=tu_clave_de_gemini_aqui

# Modelo de Google Gemini (opcional, por defecto: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Orígenes CORS autorizados adicionales (opcional, separados por comas)
ALLOWED_ORIGINS=https://mathverse.edu.pe,https://mathverse.vercel.app

# ========================================================
# Rate Limiting Distribuido (Upstash Redis)
# ========================================================
# Configura estas variables en Vercel para habilitar almacenamiento distribuido.
# Crea una base de datos Redis gratuita en: https://console.upstash.com/
#
# IMPORTANTE (Despliegue en Vercel):
# Tras configurar o actualizar las variables de entorno de Upstash en el panel
# de Vercel (Project Settings > Environment Variables), es INDISPENSABLE realizar
# un NUEVO DESPLIEGUE (Redeploy) del proyecto.
# Las funciones serverless de Vercel inyectan las variables de entorno al compilar/desplegar;
# por lo tanto, no surtirán efecto en /api/chat hasta que el nuevo despliegue finalice.
UPSTASH_REDIS_REST_URL=https://tu-endpoint.upstash.io
UPSTASH_REDIS_REST_TOKEN=tu_token_upstash_aqui

# Parámetros de límite de tasa (opcionales, valores predeterminados recomendados)
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_SHARED_IP_BURST=60
